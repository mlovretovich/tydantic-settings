{
  "name": "tydantic-settings",
  "version": "0.1.0",
  "description": "Type-safe configuration management library for TypeScript applications",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.41"
  },
  "devDependencies": {
    "@aws-sdk/client-secrets-manager": "^3.989.0",
    "@types/node": "^25.2.3",
    "dotenv": "^17.3.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "configuration",
    "settings",
    "typescript",
    "typebox",
    "env",
    "dotenv",
    "type-safe"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/tydantic-settings.git"
  },
  "engines": {
    "node": ">=18"
  }
}

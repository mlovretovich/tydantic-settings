{
  "name": "tydantic-settings",
  "version": "0.1.1",
  "description": "Type-safe configuration management library for TypeScript applications",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --project tsconfig.check.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.41",
    "dotenv": "^16.0.0 || ^17.0.0"
  },
  "peerDependencies": {
    "@aws-sdk/client-secrets-manager": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-secrets-manager": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-secrets-manager": "^3.989.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.2.3",
    "dotenv": "^17.3.0",
    "eslint": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.1",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.56.0",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "configuration",
    "settings",
    "typescript",
    "typebox",
    "env",
    "dotenv",
    "type-safe"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mlovretovich/tydantic-settings.git"
  },
  "engines": {
    "node": ">=18"
  }
}
